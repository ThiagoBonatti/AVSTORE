# Porta em que o servidor vai rodar
PORT=3000

# ---------------------------------------------------------------------------
# Credenciais do Firebase Admin SDK (backend) — use UMA das opcoes abaixo.
# Veja no README o passo a passo de como gerar cada uma no console do Firebase.
# ---------------------------------------------------------------------------

# Opcao 1 (recomendada para desenvolvimento local): caminho para o arquivo
# JSON da chave de servico baixado em
# Configuracoes do projeto > Contas de servico > Gerar nova chave privada
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Opcao 2: cole o JSON inteiro da chave de servico em uma unica linha
# (util em plataformas de hospedagem que nao aceitam upload de arquivo)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Opcao 3: variaveis separadas extraidas do mesmo JSON
# FIREBASE_PROJECT_ID=seu-projeto-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIExemplo...\n-----END PRIVATE KEY-----\n"

# Nome do bucket do Firebase Storage (Configuracoes do projeto > geral, ou
# na aba Storage do console). Formato costuma ser "seu-projeto.appspot.com"
# ou "seu-projeto.firebasestorage.app" em projetos mais novos.
# Ex. deste projeto (avstore-4f2fc): FIREBASE_STORAGE_BUCKET=avstore-4f2fc.firebasestorage.app
FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com

# ---------------------------------------------------------------------------
# Usuario administrador criado pelo "npm run seed" no Firebase Authentication
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@avstore.com
ADMIN_PASSWORD=TrocarSenha123!
